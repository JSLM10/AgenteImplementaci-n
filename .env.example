# ─────────────────────────────────────────────────────────────────────────────
# VAR — Verificador Aumentado de Respuestas
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────────────────────
# Local (docker compose levanta este Postgres con pgvector ya instalado).
DATABASE_URL=postgresql+psycopg://var:var@localhost:5432/vardb
# En la nube se reemplaza por la cadena de Neon/Supabase, que exige SSL:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host.neon.tech/vardb?sslmode=require

# ─── Modelo de lenguaje ──────────────────────────────────────────────────────
# "ollama" en local y en la demo; "huggingface" en la nube.
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Razonamiento explicito del modelo. Dejar en false: con el activo, las
# llamadas cortas (clasificacion, veredictos) se quedan sin tokens dentro del
# bloque de pensamiento y devuelven texto vacio, y la velocidad cae a la mitad.
OLLAMA_REASONING=false

# HuggingFace (solo cuando LLM_PROVIDER=huggingface)
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ─── Embeddings ──────────────────────────────────────────────────────────────
# NO cambiar despues de haber ingestado documentos: la base vectorial quedaria
# inservible porque los vectores viejos tendrian otra dimension y otro espacio
# semantico. Para cambiarlo hay que re-ingestar todo desde cero.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# ─── RAG ─────────────────────────────────────────────────────────────────────
# Numero de fragmentos que se recuperan antes de filtrar por score.
RETRIEVAL_K=6
# Umbral minimo de similitud [0..1]. Los fragmentos por debajo se descartan
# antes de llegar al modelo. Subirlo = mas rechazos pero mas precision.
RETRIEVAL_MIN_SCORE=0.35
# Tamano de los fragmentos en caracteres y solape entre fragmentos contiguos.
CHUNK_SIZE=500
CHUNK_OVERLAP=120
# Nodo extra que revisa que la respuesta no se salga del contexto.
# Duplica el coste de inferencia; encenderlo solo si la latencia lo permite.
ENABLE_GROUNDEDNESS_CHECK=false

# ─── Autenticacion ───────────────────────────────────────────────────────────
# "local" = JWT propio. "keycloak" = validacion OIDC contra el realm.
AUTH_PROVIDER=local

# Clave para firmar los JWT propios. CAMBIAR en cualquier entorno real:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-en-produccion-por-favor
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak (solo cuando AUTH_PROVIDER=keycloak)
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=var
KEYCLOAK_CLIENT_ID=var-backend

# ─── Carga de documentos ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
STORAGE_DIR=./storage
# Ingesta de imagenes (OCR) y audio/video (Whisper). Requiere dependencias de
# sistema extra; fuera del alcance de esta entrega.
ENABLE_MEDIA_INGEST=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origenes del frontend separados por coma. En produccion, el dominio de Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Frontend ────────────────────────────────────────────────────────────────
# Lo lee Vite en tiempo de build (frontend/.env).
VITE_API_URL=http://localhost:8000
